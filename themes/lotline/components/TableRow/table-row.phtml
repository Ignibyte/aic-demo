<?php /** @var \App\Theme\Components\TableRow\TableRow $tableRow */ ?>
<tr<?php if ($tableRow->gone): ?> class="opacity-60 line-through"<?php else: ?> class="has-[[aria-invalid=true]]:bg-error/10"<?php endif; ?>><?php foreach ($tableRow->cells as $tableCell): ?><td<?php if ($tableCell->mono): ?> class="whitespace-nowrap font-mono text-xs"<?php elseif ($tableCell->numeric): ?> class="text-right tabular-nums"<?php endif; ?>><?php foreach ($tableCell->boxes as $rowBox): ?><input class="checkbox checkbox-sm me-2 align-middle" type="checkbox" name="<?= $rowBox->name ?>" value="<?= $rowBox->value ?>" form="<?= $rowBox->form ?>" aria-label="<?= $rowBox->label ?>" data-bind:selected data-on:tessera:patched__document="el.checked = $selected.includes(el.value)"<?php if ($rowBox->checked): ?> checked<?php endif; ?><?php if ($rowBox->error !== ''): ?> aria-invalid="true" aria-describedby="refused-<?= $rowBox->value ?>"<?php endif; ?>><?php endforeach ?><?php if ($tableCell->edit !== ''): ?><a class="link link-hover" href="<?= $tableCell->href ?>" data-prefetch="off" data-on:click__prevent="@get('<?= $tableCell->edit ?>')"><?php if ($tableCell->badgeTone !== null): ?><span class="badge badge-sm <?= $tableCell->badgeTone->value ?>"><?= $tableCell->text ?></span><?php else: ?><?= $tableCell->text ?><?php endif; ?></a><?php elseif ($tableCell->badgeTone !== null): ?><span class="badge badge-sm <?= $tableCell->badgeTone->value ?>"><?= $tableCell->text ?></span><?php elseif ($tableCell->href !== ''): ?><a class="link link-hover" href="<?= $tableCell->href ?>"><?= $tableCell->text ?></a><?php else: ?><?= $tableCell->text ?><?php endif; ?><?php foreach ($tableCell->boxes as $rowBox): ?><?php if ($rowBox->error !== ''): ?><p class="mt-1 whitespace-normal font-sans text-xs text-error" id="refused-<?= $rowBox->value ?>"><?= $rowBox->error ?></p><?php endif; ?><?php endforeach ?></td><?php endforeach ?></tr>
