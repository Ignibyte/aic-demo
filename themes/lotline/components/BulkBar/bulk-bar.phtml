<?php /** @var \App\Theme\Components\BulkBar\BulkBar $bulkBar */ ?>
<form class="flex flex-col gap-2 rounded-box border border-base-300 bg-base-200/50 p-3" id="<?= $bulkBar->id ?>" method="post" action="<?= $bulkBar->action ?>"<?php if ($bulkBar->bulkConfirm->confirming): ?> data-signals="{choice: '<?= $bulkBar->bulkConfirm->remove ?>', confirming: true, answered: 0}"<?php else: ?> data-signals="{choice: '', confirming: false, answered: 0}"<?php endif; ?> data-on:submit__prevent="$answered = 0; ($choice === '<?= $bulkBar->bulkConfirm->remove ?>' ? !$confirming : false) ? $confirming = true : el.hasAttribute('data-loading') ? null : $answered = (await @post('<?= $bulkBar->action ?>', {form: true, target: '@<?= $bulkBar->rowAnchor ?>' + $selected.join(' @<?= $bulkBar->rowAnchor ?>') + ' @<?= $bulkBar->totals ?>'})).httpStatus; $answered === 0 ? null : $confirming = false; $answered === 200 ? $selected = [] : null" data-on:tessera:patched__document="evt.target.getAttribute('data-t-anchor') === '<?= $bulkBar->results ?>' ? $selected = [] : null"><?= $bulkBar->guardFields ?><input type="hidden" name="return" value="<?= $bulkBar->back ?>"><input type="hidden" name="confirmed" value="yes"<?php if (!$bulkBar->bulkConfirm->confirming): ?> disabled<?php endif; ?> data-attr:disabled="!$confirming">
<fieldset class="flex flex-wrap items-center gap-2" data-signals__region="{selected: []}" data-attr:disabled="$selected.length === 0"><label class="text-sm" for="<?= $bulkBar->id ?>-choice"><?= $bulkBar->label ?></label><select class="select select-sm w-52" id="<?= $bulkBar->id ?>-choice" name="bulk" data-bind:choice><option value="">Choose an action</option><?php foreach ($bulkBar->choices as $selectOption): ?><option value="<?= $selectOption->value ?>"<?php if ($selectOption->selected): ?> selected<?php endif; ?>><?= $selectOption->label ?></option><?php endforeach ?></select><button class="btn btn-primary btn-sm" type="submit" id="<?= $bulkBar->id ?>-apply">Apply</button><span class="text-sm opacity-70" id="<?= $bulkBar->id ?>-count" hidden data-attr:hidden="$selected.length === 0" data-text="$selected.length + ' selected'"></span></fieldset>
<div class="flex flex-wrap items-center gap-2 rounded-box border border-error/40 bg-base-100 p-3" id="<?= $bulkBar->id ?>-confirm" role="alertdialog" aria-labelledby="<?= $bulkBar->id ?>-question"<?php if (!$bulkBar->bulkConfirm->confirming): ?> hidden<?php endif; ?> data-attr:hidden="!$confirming"><p class="font-medium" id="<?= $bulkBar->id ?>-question"><?= $bulkBar->bulkConfirm->question ?></p><p class="text-sm" id="<?= $bulkBar->id ?>-ticked" data-text="$selected.length + ' ticked'"><?= $bulkBar->bulkConfirm->ticked ?> ticked</p><p class="text-sm"><?= $bulkBar->bulkConfirm->warning ?></p><button class="btn btn-error btn-sm" type="submit" id="<?= $bulkBar->id ?>-delete" data-effect="$confirming ? el.focus() : null">Delete them</button><a class="btn btn-ghost btn-sm" href="<?= $bulkBar->back ?>" id="<?= $bulkBar->id ?>-keep" data-enhance="off" data-on:click__prevent="$confirming = false">Keep them</a></div></form>
