<?php /** @var \App\Theme\Components\ChatSendForm\ChatSendForm $chatSendForm */ ?>
<form class="flex flex-col gap-2" id="<?= $chatSendForm->id ?>" method="post" action="<?= $chatSendForm->action ?>" data-target="@chat-send" data-signals__region="{chatSent: 0}"><?php if ($chatSendForm->ended): ?><p class="text-sm opacity-70" id="<?= $chatSendForm->id ?>-ended" role="status">This chat has ended.</p><?php else: ?><?= $chatSendForm->guardFields ?><?php if ($chatSendForm->back !== ''): ?><input type="hidden" name="back" value="<?= $chatSendForm->back ?>"><?php endif; ?><?php if ($chatSendForm->reason !== ''): ?><p class="text-sm text-error" id="<?= $chatSendForm->id ?>-reason" role="alert" tabindex="-1" data-error-summary><?= $chatSendForm->reason ?></p><?php endif; ?><label class="sr-only" for="<?= $chatSendForm->id ?>-message"><?= $chatSendForm->label ?></label><textarea class="textarea textarea-sm w-full" id="<?= $chatSendForm->id ?>-message" name="message" rows="2" placeholder="Write a message" data-ignore-morph data-on:keydown__enter="evt.shiftKey ? null : evt.preventDefault(); evt.shiftKey ? null : el.form.requestSubmit()" data-on:input__throttle.2s="@post('<?= $chatSendForm->typing ?>', {target: ''})" data-effect="$chatSent > 0 ? el.value = '' : null"<?php if ($chatSendForm->reason !== ''): ?> aria-invalid="true" aria-describedby="<?= $chatSendForm->id ?>-reason"<?php endif; ?><?php if ($chatSendForm->autofocus): ?> autofocus<?php endif; ?>><?= $chatSendForm->message ?></textarea><button class="btn btn-primary btn-sm self-end" id="<?= $chatSendForm->id ?>-go" type="submit">Send</button><?php endif; ?></form>
