<?php /** @var \App\Theme\Components\ChatList\ChatList $chatList */ ?>
<div class="overflow-x-auto" id="chat-list" data-poll__5s="<?= $chatList->poll ?>"><?php if ($chatList->rows === []): ?><p class="opacity-70" id="chat-list-empty">No chats yet. A chat a visitor starts on a car's page shows here.</p><?php else: ?><table class="table table-sm"><thead><tr><th>Car</th><th>Visitor</th><th>With</th><th>Status</th><th>Newest</th><th>Unread</th></tr></thead><tbody><?php foreach ($chatList->rows as $chatRow): ?><tr id="chat-row-<?= $chatRow->id ?>"><td><a class="link link-hover font-medium" href="<?= $chatRow->path ?>"><?= $chatRow->car ?></a></td><td><?= $chatRow->visitor ?></td><td><?= $chatRow->staff ?></td><td><span class="badge badge-sm <?= $chatRow->open ? 'badge-success' : 'badge-ghost' ?>"><?= $chatRow->open ? 'Open' : 'Ended' ?></span></td><td><time><?= $chatRow->latest ?></time></td><td><span class="badge badge-sm <?= $chatRow->unread > 0 ? 'badge-primary' : 'badge-ghost' ?>" id="chat-unread-<?= $chatRow->id ?>"><?= $chatRow->unread ?></span></td></tr><?php endforeach ?></tbody></table><?php endif; ?></div>
