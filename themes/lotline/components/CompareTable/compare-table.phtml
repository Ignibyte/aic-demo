<?php /** @var \App\Theme\Components\CompareTable\CompareTable $compareTable */ ?>
<div class="overflow-x-auto rounded-box border border-base-300"><table class="table table-sm" id="<?= $compareTable->id ?>"><caption class="p-2 text-left text-sm opacity-70"><?= $compareTable->caption ?></caption><thead><tr><th scope="col"><span class="sr-only">Fact</span></th><?php foreach ($compareTable->cars as $comparedCar): ?><th class="min-w-40" scope="col"><a class="link font-semibold" href="<?= $comparedCar->href ?>"><?= $comparedCar->title ?></a></th><?php endforeach ?></tr></thead><tbody><tr><th scope="row">Photo</th><?php foreach ($compareTable->cars as $comparedCar): ?><td><?php if ($comparedCar->photoSrc !== ''): ?><img class="aspect-[4/3] w-40 rounded object-cover" src="<?= $comparedCar->photoSrc ?>" alt="<?= $comparedCar->photoAlt ?>"><?php else: ?><span class="flex aspect-[4/3] w-40 items-center justify-center rounded bg-base-300 text-xs opacity-70">No photo yet</span><?php endif; ?></td><?php endforeach ?></tr><tr><th scope="row">Year</th><?php foreach ($compareTable->cars as $comparedCar): ?><td><?= $comparedCar->year ?></td><?php endforeach ?></tr><tr><th scope="row">Make</th><?php foreach ($compareTable->cars as $comparedCar): ?><td><?= $comparedCar->make ?></td><?php endforeach ?></tr><tr><th scope="row">Model</th><?php foreach ($compareTable->cars as $comparedCar): ?><td><?= $comparedCar->model ?></td><?php endforeach ?></tr><tr><th scope="row">Trim</th><?php foreach ($compareTable->cars as $comparedCar): ?><td><?= $comparedCar->trim ?></td><?php endforeach ?></tr><tr><th scope="row">Mileage</th><?php foreach ($compareTable->cars as $comparedCar): ?><td><?= $comparedCar->mileage ?></td><?php endforeach ?></tr><tr><th scope="row">Price</th><?php foreach ($compareTable->cars as $comparedCar): ?><td class="font-semibold"><?= $comparedCar->price ?></td><?php endforeach ?></tr><tr><th scope="row">Monthly payment</th><?php foreach ($compareTable->cars as $comparedCar): ?><td><?= $comparedCar->payment ?></td><?php endforeach ?></tr></tbody></table></div>
