<?php /** @var \App\Theme\Components\EditRow\EditRow $editRow */ ?>
<tr class="bg-base-300/40" data-signals="{typing: false}"><?php foreach ($editRow->cells as $editCell): ?><td<?php if ($editCell->mono): ?> class="whitespace-nowrap font-mono text-xs"<?php elseif ($editCell->numeric): ?> class="text-right tabular-nums"<?php endif; ?>><?php foreach ($editCell->fields as $editField): ?><?php if ($editField->type === 'select'): ?><select class="select select-sm w-36<?php if ($editField->error !== ''): ?> select-error<?php endif; ?>" id="<?= $editField->id ?>" name="<?= $editField->name ?>" form="<?= $editRow->form ?>" aria-label="<?= $editField->label ?>" data-on:input="$typing = true" data-attr:data-ignore-morph="$typing" data-on:keydown__enter__prevent="el.form.requestSubmit()" data-on:keydown__escape__prevent="$typing = false; @get('<?= $editRow->cancel ?>')"<?php if ($editField->error !== ''): ?> aria-invalid="true" aria-describedby="error-<?= $editField->id ?>" data-init="el.focus()"<?php elseif ($editField->first): ?> data-init="el.focus()"<?php endif; ?>><?php foreach ($editField->options as $selectOption): ?><option value="<?= $selectOption->value ?>"<?php if ($selectOption->selected): ?> selected<?php endif; ?>><?= $selectOption->label ?></option><?php endforeach ?></select><?php else: ?><input class="input input-sm w-32<?php if ($editField->error !== ''): ?> input-error<?php endif; ?>" id="<?= $editField->id ?>" name="<?= $editField->name ?>" type="<?= $editField->type ?>" value="<?= $editField->value ?>" form="<?= $editRow->form ?>" aria-label="<?= $editField->label ?>" autocomplete="off" data-on:input="$typing = true" data-attr:data-ignore-morph="$typing" data-on:keydown__enter__prevent="el.form.requestSubmit()" data-on:keydown__escape__prevent="$typing = false; @get('<?= $editRow->cancel ?>')"<?php if ($editField->error !== ''): ?> aria-invalid="true" aria-describedby="error-<?= $editField->id ?>" data-init="el.focus()"<?php elseif ($editField->first): ?> data-init="el.focus(); el.select()"<?php endif; ?>><?php endif; ?><?php if ($editField->error !== ''): ?><p class="mt-1 whitespace-normal text-xs text-error" id="error-<?= $editField->id ?>"><?= $editField->error ?></p><?php endif; ?><?php endforeach ?><?php if (empty($editCell->fields)): ?><?= $editCell->text ?><?php endif; ?><?php if ($editCell->actions): ?><form class="mt-1 flex flex-wrap items-center gap-1" id="<?= $editRow->form ?>" data-on:submit__prevent="$typing = false; el.hasAttribute('data-loading') || @put('<?= $editRow->save ?>', {form: true})"><?php if ($editRow->error !== ''): ?><p class="w-full whitespace-normal text-xs text-error" id="error-<?= $editRow->form ?>"><?= $editRow->error ?></p><?php endif; ?><button class="btn btn-primary btn-xs" type="submit">Save</button><button class="btn btn-ghost btn-xs" type="button" data-on:click="$typing = false; @get('<?= $editRow->cancel ?>')">Cancel</button></form><?php endif; ?></td><?php endforeach ?></tr>
