<?xml version="1.0"?>
<ruleset name="App"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>gate:11 (aic/gates' stub, #130): the rules are the package's base; this file names the app's files, its cache and one root namespace per module, which aic-gate init writes from the modules on disk.</description>

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>

    <file>modules</file>
    <file>themes</file>
    <file>build/generated</file>
    <file>public</file>
    <file>bootstrap</file>
    <file>config</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>.rector-cache/*</exclude-pattern>
    <exclude-pattern>.psalm-cache/*</exclude-pattern>

    <rule ref="./vendor/aic/gates/config/phpcs.xml"/>

    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <properties>
            <property name="rootNamespaces" type="array">
                <element key="modules/customers/src" value="App\Customers"/>
                <element key="modules/dashboard/src" value="App\Dashboard"/>
                <element key="modules/inventory/src" value="App\Inventory"/>
                <element key="modules/photos/src" value="App\Photos"/>
                <element key="modules/sales/src" value="App\Sales"/>
                <element key="modules/site/src" value="App\Site"/>
                <element key="modules/staff/src" value="App\Staff"/>
                <element key="themes/lotline/src/Components" value="App\Theme\Components"/>
                <element key="themes/lotline/src/Layouts" value="App\Theme\Layouts"/>
                <element key="build/generated" value="App\Generated"/>
            </property>
        </properties>
    </rule>
</ruleset>
